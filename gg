-- 2. SHEDLETSKY AIMBOT (LOGIC GỐC 100% - INPUT RANGE)
-- =================================================================
do
    getgenv().ShedletskyActive = false
    local ShedSection = Tabs.Combat:Section({ Title = "Shedletsky", Opened = true, Box = false })
    local shedletskyRange = 80
    
    local SlashCooldown, AimDuration, LastSlashTime = 40.0, 1.0, 0
    local IsAiming, AimEndTime, AimTarget, SlashButton, Connection = false, 0, nil, nil, nil

    local function FindSlashButton()
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then return nil end
        local main = gui:FindFirstChild("MainUI")
        local container = main and main:FindFirstChild("AbilityContainer")
        return container and (container:FindFirstChild("Slash") or container:FindFirstChild("Katana"))
    end

    local function GetClosestKiller()
        local closest, minDist = nil, shedletskyRange
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local isKiller = (plr.Team and (plr.Team.Name == "Killers" or plr.Team.Name == "Killer")) or (plr.Character.Parent and plr.Character.Parent.Name == "Killers")
                    if isKiller then
                        local dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        if dist < minDist then minDist = dist; closest = hrp end
                    end
                end
            end
        end
        return closest
    end

    local function HookSlashButton()
        if not getgenv().ShedletskyActive then return end
        local btn = FindSlashButton()
        if btn and btn ~= SlashButton then
            SlashButton = btn
            if Connection then Connection:Disconnect() end
            Connection = SlashButton.MouseButton1Click:Connect(function()
                if not getgenv().ShedletskyActive then return end
                if tick() - LastSlashTime < SlashCooldown then return end
                local target = GetClosestKiller()
                if target then
                    AimTarget = target; IsAiming = true; AimEndTime = tick() + AimDuration; LastSlashTime = tick()
                    Notify("Shedletsky", "Slashing!", 1)
                end
            end)
        end
    end
    
    task.spawn(function() while true do if getgenv().ShedletskyActive then HookSlashButton() end task.wait(1) end end)
    RunService.RenderStepped:Connect(function()
        if getgenv().ShedletskyActive and IsAiming and AimTarget and AimTarget.Parent then
            if tick() < AimEndTime then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local myRoot = myChar.HumanoidRootPart
                    local human = myChar:FindFirstChild("Humanoid")
                    if human then human.AutoRotate = false end
                    local targetPos = AimTarget.Position
                    myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z))
                end
            else
                IsAiming = false; AimTarget = nil
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.AutoRotate = true end
            end
        end
    end)
    
    ShedSection:Toggle({ Title = "Tự động chém (Shedletsky)", Default = false, Callback = function(state) getgenv().ShedletskyActive = state end })
    
    ShedSection:Input({
        Title = "Skill Range (Nhập số)",
        Default = "80",
        Placeholder = "Ví dụ: 80",
        Numeric = true,
        Finished = true,
        Callback = function(Text)
            local num = tonumber(Text)
            if num then
                shedletskyRange = num
                Notify("Cài đặt", "Shedletsky Range: " .. num)
            end
        end
    })
end

