local function makeButton(text, x, y, w, color)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, w, 0, 40)
	btn.Position = UDim2.new(0, x, 0, y)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.BorderSizePixel = 0
	btn.Parent = main

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = btn

	return btn
end

local minusBtn = makeButton("-", 14, 145, 60, Color3.fromRGB(45, 45, 60))
local resetBtn = makeButton("Reset", 82, 145, 90, Color3.fromRGB(75, 75, 95))
local plusBtn = makeButton("+", 180, 145, 60, Color3.fromRGB(130, 100, 255))

minusBtn.MouseButton1Click:Connect(function()
	setSpeed(currentSpeed - STEP_SPEED)
end)

plusBtn.MouseButton1Click:Connect(function()
	setSpeed(currentSpeed + STEP_SPEED)
end)

resetBtn.MouseButton1Click:Connect(function()
	setSpeed(DEFAULT_SPEED)
end)

closeBtn.MouseButton1Click:Connect(function()
	gui.Enabled = false
end)

local dragging = false
local dragStart
local startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = shadow.Position
	end
end)

topBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

	local delta = input.Position - dragStart
	shadow.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end)

setSpeed(DEFAULT_SPEED)
