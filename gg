-- 1. GUEST 1337 (LOGIC GỐC 100%)
-- =================================================================
do
    getgenv().GuestActive = false
    local GuestSection = Tabs.Combat:Section({ Title = "Guest 1337", Opened = true, Box = false })
    
    local GuestRange = 7
    local IsAiming = false
    local AimEndTime = 0
    local AimTarget = nil
    local ComboCooldown = false 
    local BlockBtn, PunchBtn = nil, nil

    local function FireButton(button)
        if not button then return end
        for _, conn in ipairs(getconnections(button.MouseButton1Click)) do conn:Fire() end
        for _, conn in ipairs(getconnections(button.Activated)) do conn:Fire() end
        pcall(function() button:Activate() end)
    end

    local function FindGuestButtons()
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then return end
        local main = gui:FindFirstChild("MainUI")
        local container = main and main:FindFirstChild("AbilityContainer")
        if container then
            BlockBtn = container:FindFirstChild("Block") or container:FindFirstChild("Shield")
            PunchBtn = container:FindFirstChild("Punch") or container:FindFirstChild("Counter")
        end
    end

    local function TriggerRapidCombo(target)
        ComboCooldown = true
        FireButton(BlockBtn)
        Notify("Guest 1337", "BLOCK & SPAM PUNCH!", 1)
        IsAiming = true; AimTarget = target; AimEndTime = tick() + 1.0
        task.spawn(function()
            for i = 1, 20 do if PunchBtn then FireButton(PunchBtn) end task.wait(0.02) end
        end)
        task.delay(1.5, function() ComboCooldown = false end)
    end

    RunService.RenderStepped:Connect(function()
        if not getgenv().GuestActive then return end
        if IsAiming then
            if tick() < AimEndTime and AimTarget and AimTarget.Parent then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local myRoot = myChar.HumanoidRootPart
                    local human = myChar:FindFirstChild("Humanoid")
                    if human then human.AutoRotate = false end
                    local targetPos = AimTarget.Position
                    myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z))
                end
            else
                IsAiming = false; AimTarget = nil
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("Humanoid") then myChar.Humanoid.AutoRotate = true end
            end
        end
        if not ComboCooldown then
            local killers = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Killers")
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if killers and myRoot then
                for _, k in ipairs(killers:GetChildren()) do
                    local kRoot = k:FindFirstChild("HumanoidRootPart")
                    local kHum = k:FindFirstChild("Humanoid")
                    if kRoot and kHum and kHum.Health > 0 then
                        if (kRoot.Position - myRoot.Position).Magnitude <= GuestRange then
                            local animator = kHum:FindFirstChild("Animator")
                            if animator then
                                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                    if (track.Priority == Enum.AnimationPriority.Action or track.Priority == Enum.AnimationPriority.Action2 or track.Priority == Enum.AnimationPriority.Action3) and track.Speed > 0 and track.TimePosition < 0.4 then
                                        TriggerRapidCombo(kRoot); return
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    task.spawn(function() while true do if getgenv().GuestActive then FindGuestButtons() end task.wait(1) end end)
    
    GuestSection:Toggle({ 
        Title = "Tự động phản đòn (Auto Counter)", 
        Default = false, 
        Callback = function(state) getgenv().GuestActive = state end 
    })
end

