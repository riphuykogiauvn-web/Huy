local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "VeLusx",
    Icon = "sparkles",
    Author = "Zan",
    Folder = "VeLusx_Menu",
    Size = UDim2.fromOffset(760, 520),
    Theme = "Dark",
    HidePanelBackground = false,
    NewElements = true,
})

pcall(function()
    Window:SetBackgroundTransparency(0.18)
end)

pcall(function()
    Window:SetBackgroundImageTransparency(1)
end)

local MainTab = Window:Tab({
    Title = "Main",
    Icon = "home",
})

local MiscTab = Window:Tab({
    Title = "Misc",
    Icon = "settings-2",
})

local CombatTab = Window:Tab({
    Title = "Combat",
    Icon = "swords",
})

local PlayerTab = Window:Tab({
    Title = "Player",
    Icon = "user",
})

local VisualTab = Window:Tab({
    Title = "Visual",
    Icon = "eye",
})

local ConfigTab = Window:Tab({
    Title = "Config",
    Icon = "folder",
})

MainTab:Toggle({
    Title = "Menu Active",
    Desc = "Chỉ là giao diện demo",
    Flag = "menu_active",
    Value = true,
    Callback = function(v)
        print("Menu Active:", v)
    end,
})

MainTab:Button({
    Title = "Button Test",
    Icon = "zap",
    Callback = function()
        print("Button Test")
    end,
})

MainTab:Input({
    Title = "Search Box",
    Placeholder = "Nhập nội dung...",
    Callback = function(text)
        print("Input:", text)
    end,
})

MiscTab:Toggle({
    Title = "Auto Open",
    Desc = "Bật/tắt thử giao diện",
    Flag = "auto_open",
    Value = false,
    Callback = function(v)
        print("Auto Open:", v)
    end,
})

MiscTab:Slider({
    Title = "UI Scale",
    Desc = "Chỉ để nhìn giống menu video",
    Flag = "ui_scale",
    Value = {
        Min = 50,
        Max = 150,
        Default = 100
    },
    Step = 1,
    Callback = function(v)
        print("UI Scale:", v)
    end,
})

MiscTab:Dropdown({
    Title = "Preset",
    Desc = "Chọn kiểu hiển thị",
    Flag = "preset",
    SearchBarEnabled = true,
    Values = {
        "Default",
        "Glass",
        "Soft Purple",
        "Dark Pink",
        "Minimal"
    },
    Value = "Glass",
    Callback = function(v)
        print("Preset:", v)
    end,
})

CombatTab:Toggle({
    Title = "Combat Panel",
    Desc = "Chỉ là nút demo",
    Flag = "combat_panel",
    Value = false,
    Callback = function(v)
        print("Combat Panel:", v)
    end,
})

CombatTab:Slider({
    Title = "Attack Speed",
    Desc = "Thanh kéo test",
    Flag = "attack_speed",
    Value = {
        Min = 0,
        Max = 100,
        Default = 25
    },
    Step = 1,
    Callback = function(v)
        print("Attack Speed:", v)
    end,
})

CombatTab:Button({
    Title = "Test Combat Button",
    Icon = "flame",
    Callback = function()
        print("Combat button pressed")
    end,
})

PlayerTab:Slider({
    Title = "WalkSpeed",
    Desc = "Thanh kéo test",
    Flag = "walkspeed",
    Value = {
        Min = 0,
        Max = 100,
        Default = 16
    },
    Step = 1,
    Callback = function(v)
        print("WalkSpeed:", v)
    end,
})

PlayerTab:Slider({
    Title = "JumpPower",
    Desc = "Thanh kéo test",
    Flag = "jumppower",
    Value = {
        Min = 0,
        Max = 200,
        Default = 50
    },
    Step = 1,
    Callback = function(v)
        print("JumpPower:", v)
    end,
})

PlayerTab:Toggle({
    Title = "Auto Sprint",
    Desc = "Toggle test",
    Flag = "auto_sprint",
    Value = false,
    Callback = function(v)
        print("Auto Sprint:", v)
    end,
})

VisualTab:Dropdown({
    Title = "Theme",
    Desc = "Đổi theme có sẵn",
    Flag = "theme_select",
    SearchBarEnabled = true,
    Values = {
        "Dark",
        "Light",
        "Rose",
        "Plant",
        "Indigo",
        "Sky",
        "Violet",
        "Amber"
    },
    Value = "Dark",
    Callback = function(theme)
        pcall(function()
            WindUI:SetTheme(theme)
        end)
        print("Theme:", theme)
    end,
})

VisualTab:Toggle({
    Title = "Glass Mode",
    Desc = "Làm menu mờ hơn",
    Flag = "glass_mode",
    Value = true,
    Callback = function(v)
        pcall(function()
            if v then
                Window:SetBackgroundTransparency(0.18)
            else
                Window:SetBackgroundTransparency(0.08)
            end
        end)
        print("Glass Mode:", v)
    end,
})

VisualTab:Button({
    Title = "Refresh Look",
    Icon = "refresh-cw",
    Callback = function()
        pcall(function()
            Window:SetBackgroundTransparency(0.18)
            Window:SetBackgroundImageTransparency(1)
        end)
        print("Refreshed")
    end,
})

ConfigTab:Button({
    Title = "Save Config",
    Icon = "save",
    Callback = function()
        print("Save config pressed")
    end,
})

ConfigTab:Button({
    Title = "Load Config",
    Icon = "folder-open",
    Callback = function()
        print("Load config pressed")
    end,
})

ConfigTab:Button({
    Title = "Reset UI",
    Icon = "rotate-ccw",
    Callback = function()
        print("Reset pressed")
    end,
})

pcall(function()
    WindUI:Notify({
        Title = "WindUI",
        Content = "Menu loaded successfully",
        Icon = "check",
        Duration = 2
    })
end)
