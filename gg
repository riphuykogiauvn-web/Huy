-- 1. KILLER AIMBOT (FIXED: ANTI-BLACK SCREEN CUTSCENE)
-- =================================================================
do
    getgenv().KillerAimbotActive = false
    -- 💥 CÔNG THỨC CHUẨN WINDUI: Opened = true (luôn mở), Box = false (xóa khung + xóa mũi tên) 💥
    local AimSection = Tabs.Combat:Section({ Title = "Killer Aimbot", Opened = true, Box = false })
    
    local AimConfig = { Range = 80, Smoothness = 0.8 }
    local FOVRing = nil
    
    -- Setup Drawing for FOV
    local Drawing = Drawing or require(game:GetService("ReplicatedStorage"):WaitForChild("Drawing"))
    pcall(function()
        if Drawing then
            FOVRing = Drawing.new("Circle")
            FOVRing.Visible = false
            FOVRing.Thickness = 2
            FOVRing.Color = Color3.fromRGB(255, 0, 0)
            FOVRing.Filled = false
            FOVRing.Transparency = 0.5
        end
    end)

    local function IsPlayerKiller()
        if LocalPlayer.Team then
            local tName = LocalPlayer.Team.Name
            if tName == "Killers" or tName == "Killer" or tName == "The Stalker" then
                return true
            end
        end
        if LocalPlayer.Character and LocalPlayer.Character.Parent then
            if LocalPlayer.Character.Parent.Name == "Killers" then
                return true
            end
        end
        return false
    end

    local function GetClosestTarget()
        local closestDist = AimConfig.Range
        local target = nil
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local isTarget = true
                if LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then 
                    isTarget = false 
                end
                
                local hum = plr.Character:FindFirstChild("Humanoid")
                -- [FIX] Kiểm tra kỹ các trạng thái "Không thể nhắm"
                if hum then
                    if hum.Health <= 0 then isTarget = false end
                    -- Nếu survivor đang ở trạng thái PlatformStand (thường là bị ngã hoặc đang bị Kill Animation) -> Bỏ qua ngay
                    if hum.PlatformStand == true then isTarget = false end
                else
                    isTarget = false
                end

                if isTarget then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local dist = (myRoot.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            target = plr.Character.HumanoidRootPart
                        end
                    end
                end
            end
        end
        return target
    end

    local function StartAimbotLoop()
        RunService:BindToRenderStep("KillerAimbotLoop", Enum.RenderPriority.Camera.Value + 1, function()
            if not getgenv().KillerAimbotActive then 
                if FOVRing then FOVRing.Visible = false end
                return 
            end

            -- [FIX QUAN TRỌNG NHẤT - CHỐNG ĐEN MÀN HÌNH]
            -- Nếu Camera đang bị game chiếm quyền (Cutscene/Kill Anim) -> DỪNG AIMBOT NGAY
            if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
                if FOVRing then FOVRing.Visible = false end
                return
            end

            if not IsPlayerKiller() then
                if FOVRing then FOVRing.Visible = false end
                return
            end

            if FOVRing and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local cam = workspace.CurrentCamera
                local rootPos = LocalPlayer.Character.HumanoidRootPart.Position
                local vector, onScreen = cam:WorldToViewportPoint(rootPos)
                if onScreen then
                    FOVRing.Position = Vector2.new(vector.X, vector.Y)
                    FOVRing.Radius = (AimConfig.Range * 500) / (vector.Z + 1)
                    FOVRing.Visible = true
                else
                    FOVRing.Visible = false
                end
            end

            local target = GetClosestTarget()
            
            -- Kiểm tra lại lần cuối
            if target and target.Parent then
                local tHum = target.Parent:FindFirstChild("Humanoid")
                if tHum and (tHum.Health <= 0 or tHum.PlatformStand) then
                    target = nil 
                end
            end

            if target and LocalPlayer.Character then
                local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    -- Sử dụng pcall để tránh lỗi CFrame gây đen màn hình
                    pcall(function()
                        local lookPos = Vector3.new(target.Position.X, myRoot.Position.Y, target.Position.Z)
                        myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, lookPos), AimConfig.Smoothness)
                    end)
                end
            end
        end)
    end

    local function StopAimbotLoop()
        RunService:UnbindFromRenderStep("KillerAimbotLoop")
        if FOVRing then FOVRing.Visible = false end
    end

    AimSection:Toggle({
        Title = "Bật Aimbot (Killer)",
        Default = false,
        Callback = function(state)
            getgenv().KillerAimbotActive = state
            if state then StartAimbotLoop() else StopAimbotLoop() end
        end
    })

    -- [UPDATE] THAY SLIDER BẰNG INPUT
    AimSection:Input({
        Title = "Aimbot Range (Nhập số)",
        Default = "80",
        Placeholder = "Ví dụ: 100",
        Numeric = true,
        Finished = true, -- Chỉ cập nhật khi nhấn Enter hoặc bỏ chọn
        Callback = function(Text)
            local num = tonumber(Text)
            if num then
                AimConfig.Range = num
                Notify("Cài đặt", "Khoảng cách Aimbot: " .. num)
            end
        end
    })
end

