            local diedConn; diedConn = humanoid.Died:Connect(function() hl:Destroy(); if diedConn then diedConn:Disconnect() end end)
        end

        local ancestryConn; ancestryConn = model.AncestryChanged:Connect(function(_, p) if not p then hl:Destroy(); if ancestryConn then ancestryConn:Disconnect() end end end)
    end

    local function CheckObject(obj)
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local humanoid = obj:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if not Players:GetPlayerFromCharacter(obj) then
                    if obj.Name == "007N7" or obj.Name == "007n7" then CreateCloneESP(obj) end
                end
            end
        end
    end

    local function StartScanning()
        for _, obj in pairs(Workspace:GetDescendants()) do task.spawn(function() CheckObject(obj) end) end
        local conn = Workspace.DescendantAdded:Connect(function(obj)
            task.delay(0.5, function() if getgenv().ESPClone007Active and obj.Parent then CheckObject(obj) end end)
        end)
        table.insert(Connections, conn)
    end

    local function StopScanning()
        ESP_Folder:ClearAllChildren()
        for _, conn in ipairs(Connections) do conn:Disconnect() end
        Connections = {}
    end

    VisualSec5:Toggle({ 
        Title = "Hiện phân thân (Clone 007N7)", 
        Default = false, 
        Callback = function(state) 
            getgenv().ESPClone007Active = state 
            if state then StartScanning() else StopScanning() end
        end 
    })
end

