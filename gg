-- [MỚI] 1x1x1x1 MINIONS ESP (EVENT BASED - NO LAG)
-- =================================================================
do
    local MinionSection = Tabs.Combat:Section({ Title = "1x1x1x1 Minions", Opened = true, Box = false })
    getgenv().ESPMinionActive = false
    
    local ESPManager = {
        Enabled = false,
        Connections = {},
        Objects = {},
        UpdateLoop = nil
    }

    function ESPManager:AddObject(model)
        if self.Objects[model] then return end 
        
        -- Kiểm tra kỹ part gốc
        local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        if not part then return end

        -- Tạo Highlight (Xanh Ngọc)
        local hl = Instance.new("Highlight")
        hl.Adornee = model
        hl.FillColor = Color3.fromRGB(0, 255, 127) -- Spring Green
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = game.CoreGui -- Bắt buộc để hiện xuyên tường
        
        -- Tạo Chữ (Tên + Mét)
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.AlwaysOnTop = true
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.Adornee = part
        bb.Parent = hl

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = Color3.fromRGB(0, 255, 127)
        txt.TextStrokeTransparency = 0
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 14
        txt.Text = "Zombie Minion"
        txt.Parent = bb

        self.Objects[model] = { hl = hl, gui = txt, part = part }

        -- SỰ KIỆN 1: TỰ HỦY KHI ZOMBIE CHẾT/BIẾN MẤT (Quan trọng để giảm lag)
        local conn = model.AncestryChanged:Connect(function(_, parent)
            if not parent then self:RemoveObject(model) end
        end)
        self.Objects[model].Conn = conn
    end

    function ESPManager:RemoveObject(model)
        local data = self.Objects[model]
        if data then
            if data.Conn then data.Conn:Disconnect() end
            if data.hl then data.hl:Destroy() end
            self.Objects[model] = nil
        end
    end

    function ESPManager:Toggle(state)
        self.Enabled = state
        if state then
            -- Quét lần đầu
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name == "1x1x1x1Zombie" and obj:IsA("Model") then
                    self:AddObject(obj)
                end
            end

            -- SỰ KIỆN 2: LẮNG NGHE KHI CÓ ZOMBIE MỚI SPAWN
            local addedConn = workspace.DescendantAdded:Connect(function(obj)
                if obj.Name == "1x1x1x1Zombie" and obj:IsA("Model") then
                    task.delay(0.5, function() -- Đợi load model
                        if self.Enabled and obj.Parent then self:AddObject(obj) end
                    end)
                end
            end)
            table.insert(self.Connections, addedConn)

            -- Vòng lặp cập nhật khoảng cách (Nhẹ nhàng 0.1s/lần)
            self.UpdateLoop = task.spawn(function()
                local Camera = workspace.CurrentCamera
                while self.Enabled do
                    for model, data in pairs(self.Objects) do
                        if model.Parent and data.part then
                            local dist = math.floor((Camera.CFrame.Position - data.part.Position).Magnitude)
                            data.gui.Text = string.format("Zombie Minion [%dm]", dist)
                        else
                            self:RemoveObject(model)
                        end
                    end
                    task.wait(0.1)
                end
            end)
        else
            -- Tắt sạch sẽ
            for _, conn in pairs(self.Connections) do conn:Disconnect() end
            self.Connections = {}
            if self.UpdateLoop then task.cancel(self.UpdateLoop) self.UpdateLoop = nil end
            for model, _ in pairs(self.Objects) do self:RemoveObject(model) end
        end
    end

    MinionSection:Toggle({
        Title = "Hiện Zombie Minion (1x1x1x1)",
        Default = false,
        Callback = function(state)
            getgenv().ESPMinionActive = state
            ESPManager:Toggle(state)
        end
    })
end

